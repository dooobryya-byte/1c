&НаКлиенте
Процедура ЗагрузитьКурсы(Команда)
	
	ЗагрузитьКурсыНаСервере();
	
	Обработчик = Новый ОписаниеОповещения("ПослеВопросаОткрытьРегистр", ЭтотОбъект);
	
	РаботаСДокументамиКлиент.ЗадатьПроизвольныйВопросПользователю(
		"Открыть регистр ""Курсы валют""?",
		,
		Обработчик);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОткрытьРегистр(Параметр1,Параметр2) Экспорт
	Оповестить("ОбновитьКурсыВалют");
	ОткрытьФорму("РегистрСведений.КурсыВалют.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура ПриИзменении(Элемент)
	Если Объект.ДатаКон < Объект.ДатаНач Тогда
		Объект.ДатаКон=Объект.ДатаНач;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Объект.ДатаНач = ТекущаяДата();
	Объект.ДатаКон = Объект.ДатаНач;
КонецПроцедуры

&НаКлиенте
Процедура ДатаКонПриИзменении(Элемент)
	Если Объект.ДатаКон > ТекущаяДата() Тогда
		Объект.ДатаКон = ТекущаяДата();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериода(Команда)
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("НачалоПериода", Объект.ДатаНач);
	ПараметрыВыбора.Вставить("КонецПериода", Объект.ДатаКон);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборПериода", ПараметрыВыбора, Элементы.ВыборПериода, , , , ОписаниеОповещения);

КонецПроцедуры   

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДопПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора, "ДатаНач,ДатаКон");

КонецПроцедуры
