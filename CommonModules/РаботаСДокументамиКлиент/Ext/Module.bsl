// Вызывает вопрос асинхронно. Отказ всегда устанавливается в Истина.
// Если пользователь ответит "Да" — будет вызван ОбработчикПродолжения.
//
// Параметры:
//   ТекстВопроса           - Строка
//   Отказ                 - Булево, устанавливается в Истина
//   ОбработчикПродолжения - ОписаниеОповещения (что выполнить при "Да")
//
Процедура ЗадатьПроизвольныйВопросПользователю(ТекстВопроса, Отказ, ОбработчикПродолжения = Неопределено) Экспорт
	
	// Блокируем действие сразу — код не будет ждать ответа
	Отказ = Истина;
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(
		"ПослеВопросаПользователю", ЭтотОбъект, ОбработчикПродолжения);
	
	ПоказатьВопрос(
		ОписаниеОповещенияОЗавершении,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		10,                         // таймаут 10 секунд
		КодВозвратаДиалога.Нет,     // ответ по умолчанию при таймауте
		"Внимание!");
	
КонецПроцедуры

// Обработчик результата вопроса
Процедура ПослеВопросаПользователю(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да И Параметры <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(Параметры);
	КонецЕсли;
	
КонецПроцедуры


Функция ИтоговоеЧислоПрописью(СуммаИтого) Экспорт   
	
	Если СуммаИтого > 0 Тогда
		
		ФормСтрока = "Л = ru_RU; ДП = Ложь";
		ПарПредмета="рубль,рубля,рублей,м,копейка,копейки,копеек,ж,2";
		ПрописьЧисла = ЧислоПрописью(СуммаИтого, ФормСтрока, ПарПредмета);
	
		СуммаИтогоПрописью = "Итого: " + ПрописьЧисла + ".";
		
	Иначе
		СуммаИтогоПрописью = "<< >>";
	КонецЕсли;
	
	Возврат СуммаИтогоПрописью;
	
КонецФункции
