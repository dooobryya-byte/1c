Функция ИтоговоеЧислоПрописью(СуммаИтого) Экспорт   
	
	Если СуммаИтого > 0 Тогда
		
		ФормСтрока = "Л = ru_RU; ДП = Ложь";
		ПарПредмета="рубль,рубля,рублей,м,копейка,копейки,копеек,ж,2";
		ПрописьЧисла = ЧислоПрописью(СуммаИтого, ФормСтрока, ПарПредмета);
	
		СуммаИтогоПрописью = ПрописьЧисла + ".";
		
	Иначе
		СуммаИтогоПрописью = "<< >>";
	КонецЕсли;
	
	Возврат СуммаИтогоПрописью;
	
КонецФункции

Функция ЭтоЧисло(Строка) Экспорт
    Если ПустаяСтрока(Строка) Тогда
        Возврат Ложь;
    КонецЕсли;
    
    Попытка
        Значение = Число(Строка);
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция СтрокаВДату(СтрокаДаты) Экспорт
    Если ПустаяСтрока(СтрокаДаты) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Части = СтрРазделить(СтрокаДаты, ".");
    Если Части.Количество() <> 3 Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Если Не ЭтоЧисло(Части[0]) Или Не ЭтоЧисло(Части[1]) Или Не ЭтоЧисло(Части[2]) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    День   = Число(Части[0]);
    Месяц  = Число(Части[1]);
    Год    = Число(Части[2]);
    
    // Простая проверка диапазонов (можно усилить)
    Если День < 1 Или День > 31 Или Месяц < 1 Или Месяц > 12 Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Возврат Дата(Год, Месяц, День);
КонецФункции
